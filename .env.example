# Azure Cosmos DB Configuration
# Copy this file to .env and fill in your CosmosDB credentials

# CosmosDB Account Endpoint (e.g., https://<account>.documents.azure.com:443/)
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/

# CosmosDB Account Key (Primary or Secondary key from Azure Portal)
COSMOS_KEY=<your-cosmos-db-key>

# Database name (will be created if it does not exist)
COSMOS_DATABASE_NAME=SyntheticHealthcareData

# Data generation settings
# Number of synthetic patients to generate
NUM_PATIENTS=100

# Number of clinical encounters per patient (min 1)
NUM_ENCOUNTERS_PER_PATIENT=3

# Locale for Faker data generation (e.g., en_US, en_GB, de_DE)
FAKER_LOCALE=en_US
